{"entries":[{"id":"jimfan-2511.00062","sourceId":"jimfan","sourceName":"范麟熙","title":"World Simulation with Video Foundation Models for Physical AI","titleZh":"使用视频基础模型进行物理 AI 世界模拟","published":"2025-10-28T00:00:00.000Z","publishedTs":1761609600000,"link":"https://aipaper.jasonlin.tech/p/jimfan-2511.00062/","image":"https://figs.jasonlin.tech/5cc0623d29641a7a.webp","summary":"Cosmos-Predict2.5 and Cosmos-Transfer2.5 are open-source world foundation models that unify text/image/video-to-world generation and achieve superior video quality and instruction alignment, enabling reliable synthetic data and closed-loop simulation for robotics.","summaryZh":"Cosmos-Predict2.5 和 Cosmos-Transfer2.5 是开源的世界基础模型，统一了文本/图像/视频到世界的生成，实现了卓越的视频质量和指令对齐，为机器人技术提供了可靠的合成数据和闭环模拟。"},{"id":"jimfan-2503.14734","sourceId":"jimfan","sourceName":"范麟熙 · NVIDIA","title":"GR00T N1: An Open Foundation Model for Generalist Humanoid Robots","titleZh":"GR00T N1：面向通用人形机器人的开放基础模型","published":"2025-03-18T00:00:00.000Z","publishedTs":1742256000000,"link":"https://aipaper.jasonlin.tech/p/jimfan-2503.14734/","image":"https://figs.jasonlin.tech/278de6f000c16606.webp","summary":"GR00T N1 is an open foundation model for humanoid robots, combining vision-language understanding with real-time motor control.","summaryZh":"GR00T N1 是一个开放的人形机器人基础模型，结合了视觉语言理解与实时运动控制。"},{"id":"jimfan-2310.12931","sourceId":"jimfan","sourceName":"范麟熙 · NVIDIA","title":"Eureka: Human-Level Reward Design via Coding Large Language Models","titleZh":"Eureka：通过编码大型语言模型实现人类级别的奖励设计","published":"2023-10-19T00:00:00.000Z","publishedTs":1697673600000,"link":"https://aipaper.jasonlin.tech/p/jimfan-2310.12931/","image":"https://figs.jasonlin.tech/f6e3986652623734.webp","summary":"Eureka uses LLMs to automatically generate reward functions that outperform human-designed ones, enabling complex manipulation skills like pen spinning.","summaryZh":"Eureka 利用大型语言模型自动生成奖励函数，其性能超越人类专家设计的奖励，并首次实现模拟 Shadow Hand 进行快速笔旋转技巧。"},{"id":"jimfan-2305.16291","sourceId":"jimfan","sourceName":"范麟熙 · NVIDIA","title":"Voyager: An Open-Ended Embodied Agent with Large Language Models","titleZh":"Voyager：基于大型语言模型的开放式具身智能体","published":"2023-05-25T00:00:00.000Z","publishedTs":1684972800000,"link":"https://aipaper.jasonlin.tech/p/jimfan-2305.16291/","image":"https://figs.jasonlin.tech/facd48cbc8c17b5b.webp","summary":"Voyager is the first LLM-powered embodied lifelong learning agent in Minecraft that continuously explores, acquires skills, and makes discoveries without human intervention.","summaryZh":"Voyager 是首个由大型语言模型驱动的 Minecraft 具身终身学习智能体，无需人工干预即可持续探索、获取技能并做出新发现。"},{"id":"jimfan-2210.03094","sourceId":"jimfan","sourceName":"范麟熙 · NVIDIA","title":"VIMA: General Robot Manipulation with Multimodal Prompts","titleZh":"VIMA：基于多模态提示的通用机器人操作","published":"2022-10-06T00:00:00.000Z","publishedTs":1665014400000,"link":"https://aipaper.jasonlin.tech/p/jimfan-2210.03094/","image":"https://figs.jasonlin.tech/383d6d4f8480f239.webp","summary":"VIMA uses multimodal prompts to unify diverse robot manipulation tasks, achieving strong generalization and data efficiency.","summaryZh":"VIMA 通过多模态提示统一多种机器人操作任务，在零样本泛化中成功率提升 2.9 倍，数据效率提升 2.7 倍。"},{"id":"jimfan-2206.08853","sourceId":"jimfan","sourceName":"范麟熙 · NVIDIA","title":"MineDojo: Building Open-Ended Embodied Agents with Internet-Scale Knowledge","titleZh":"MineDojo：利用互联网规模知识构建开放式具身智能体","published":"2022-06-17T00:00:00.000Z","publishedTs":1655424000000,"link":"https://aipaper.jasonlin.tech/p/jimfan-2206.08853/","image":"https://figs.jasonlin.tech/5a3951d34e5f4198.webp","summary":"MineDojo integrates internet-scale knowledge with Minecraft to train generalist embodied agents on thousands of open-ended tasks.","summaryZh":"MineDojo 将互联网规模的知识与 Minecraft 游戏相结合，训练通用具身智能体完成数千种开放式任务。"}]}